{
  "name": "edex-ui-bk",
  "version": "0.1.0",
  "private": true,
  "author": "Bartek Kleparski",
  "description": "Native Apple Silicon terminal for macOS inspired by futuristic HUD interfaces.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "postinstall": "npm run rebuild:native",
    "rebuild:native": "electron-builder install-app-deps --arch=arm64",
    "test:unit": "node --test test/**/*.test.js",
    "test:providers:local": "node scripts/test-local-providers.js",
    "test:smoke": "EDEX_SMOKE_TEST=1 electron .",
    "test:visual": "EDEX_VISUAL_TEST=1 electron ."
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pl.ebartnet.edex-ui-bk",
    "productName": "eDEX-UI BK",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
