{
  "name": "edex-ui-bk",
  "version": "0.1.0",
  "private": true,
  "description": "Native Apple Silicon terminal for macOS inspired by futuristic HUD interfaces.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "npm run rebuild:native",
    "rebuild:native": "electron-rebuild -f -w node-pty --arch=arm64",
    "test:smoke": "EDEX_SMOKE_TEST=1 electron .",
    "test:visual": "EDEX_VISUAL_TEST=1 electron ."
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.3.0"
  }
}
